```{=html}
<div class="research-list">
<% for (const item of items) { %>
  <div class="research-item">
    <% if (item.image) { %>
    <a href="<%- item.path %>" class="research-image-link">
      <img src="<%- item.image %>" alt="<%= item.title %>" class="research-image">
    </a>
    <% } %>
    <div class="research-content">
      <p class="research-title">
        <a href="<%- item.path %>"><%= (item['pub-info'] && item['pub-info'].reference) || item.title %></a>
      </p>
      <% if (item['pub-info'] && item['pub-info'].status) { %>
      <p class="research-status"><%= item['pub-info'].status %></p>
      <% } %>
    </div>
  </div>
<% } %>
</div>
```
